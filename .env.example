# ── LiveKit Cloud Configuration ──────────────────────────────
# Obtain from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Speech & Model Providers ─────────────────────────────────
# Google Gemini (Brain & Code Evaluator): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Groq LPU (Ultra-Fast Voice Inference <150ms TTFT): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Gnani AI (Prisma STT & Timbre TTS): https://app.gnani.ai/voice
GNANI_API_KEY=your_gnani_api_key

# ── Database (MongoDB) ───────────────────────────────────────
# Default local instance or MongoDB Atlas connection URI
MONGODB_URI=mongodb://localhost:27017/

# ── Security & Authentication ────────────────────────────────
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google OAuth 2.0 (Sign-In / Sign-Up) ─────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
